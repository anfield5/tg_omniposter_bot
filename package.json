{
  "name": "tg-post-bot",
  "version": "2.0.0",
  "private": true,
  "description": "Telegram autopost bot with two interchangeable backends: Google Apps Script and a Node.js server",
  "scripts": {
    "postinstall": "npm --prefix server install --no-audit --no-fund",
    "test": "node tests/gas.test.js && node tests/switch.test.js",
    "build:gas": "node scripts/build-gas.js",
    "push:gas": "npm run build:gas && clasp push -f",
    "deploy:gas": "npm run push:gas && clasp deploy -i \"$GAS_DEPLOYMENT_ID\" -d \"v$npm_package_version\""
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@google/clasp": "3.4.1"
  }
}
